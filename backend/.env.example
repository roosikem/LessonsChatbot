# Talk to Lessons Learned: configuration
# Copy to .env and fill in. Never commit .env (secrets). On Fargate, secrets come from SSM / Secrets Manager.
# The app validates this at startup and stops with a clear message if a combination doesn't work.

# ---------- Models ----------
LLM_PROVIDER=ollama                # ollama (local dev) | bedrock
LLM_MODEL_ID=gemma4:12b            # any Ollama chat model; bedrock e.g. us.amazon.nova-2-lite-v1:0 (check it's enabled)
LLM_MAX_TOOL_ROUNDS=2
EMBEDDING_PROVIDER=ollama          # ollama | bedrock | local (hash, tests only)
EMBEDDING_MODEL_ID=bge-m3          # bedrock e.g. amazon.titan-embed-text-v2:0 or cohere.embed-multilingual-v3
EMBEDDING_DIM=1024                 # Titan V2: 1024 | 512 | 256
OLLAMA_URL=http://localhost:11434
BEDROCK_AWS_PROFILE=default        # local: profile used only for Bedrock calls
BEDROCK_REGION=us-east-1

# ---------- Data ----------
DATA_SOURCE=file                   # file | sparql
# paths are relative to the folder you start the app from (backend/); leave them out to use the defaults
DATA_DIR=./data
DATASET_CONFIG=./config/dataset.yaml

# ---------- Search ----------
SEARCH_STORE=memory                # memory | neo4j
TOP_K_CANDIDATES=20
TOP_K_ANSWER=8
FEATURE_VECTOR_SEARCH=true
FEATURE_KEYWORD_SEARCH=true
FEATURE_CONTEXT_BOOST=true
SCORE_W_CONTEXT=0.05
SCORE_W_RELATED=0.15               # boost for lessons linked to the same / comparable context items
CONFIDENCE_MIN_SIMILARITY=0.45     # calibrate per embedding model with `app.cli eval retrieval`

# ---------- Neo4j (optional) ----------
FEATURE_NEO4J=false                # on: ingest also builds the graph, chat gets related_lessons
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                    # secret
NEO4J_DATABASE=neo4j
NEO4J_FULLTEXT_ANALYZER=english    # Lucene analyzer; match the language of the lesson texts

# ---------- SPARQL knowledge graph (optional, read-only source) ----------
FEATURE_SPARQL_SOURCE=false        # needed for DATA_SOURCE=sparql
SPARQL_ENDPOINT=                   # local stand-in: http://localhost:3030/lessons/sparql (Fuseki)
SPARQL_TOKEN=                      # secret; Bearer token, or USER/PASSWORD (basic auth)
SPARQL_USER=
SPARQL_PASSWORD=                   # secret
FUSEKI_ADMIN_PASSWORD=             # only for the local Fuseki stand-in

# ---------- Agents as separate services (empty = in-process) ----------
AGENT_EMBEDDING_URL=
AGENT_RETRIEVAL_URL=
AGENT_GRAPH_URL=
AGENT_SPARQL_URL=

# ---------- Ranking from users ----------
FEATURE_SCORE_ORDER=true           # answers list lessons in search-score order, not the model's order
FEATURE_FEEDBACK_BOOST=true        # thumbs up/down on a lesson nudge it for similar questions
SCORE_W_FEEDBACK=0.1               # max effect of feedback on a score (squashed to -1..1)
FEEDBACK_MIN_SIMILARITY=0.6        # a vote counts only for questions at least this similar
FEEDBACK_HALF_LIFE_DAYS=180        # votes fade with age

# ---------- Load and Bedrock resilience ----------
MAX_CONCURRENT_ANSWERS=8           # per container; more questions wait, then get 503 "busy"
BUSY_WAIT_SECONDS=20
BEDROCK_MAX_ATTEMPTS=4             # retries after the first try (adaptive backoff)
BEDROCK_MAX_CONNECTIONS=32
BEDROCK_READ_TIMEOUT=60
# BEDROCK_ROLE_ARN=                # Bedrock in another account: the task role assumes this role
# USER_HEADER=                     # header with the SSO user, used as the voter id for feedback

# ---------- Latency ----------
FEATURE_PARALLEL_GRADING=true      # grader runs alongside the final answer; grades applied afterwards in code
FEATURE_ANSWER_CACHE=true          # repeat question on the same index / settings -> stored answer (per container)
ANSWER_CACHE_TTL_SECONDS=900
ANSWER_CACHE_SIZE=500
FEATURE_STOP_RULE=true             # a search with a good signal goes straight to the final answer
FEATURE_AUTO_RESOLVE_CONTEXT=true  # search maps loose context values to the data's values itself
FEATURE_REASONS_IN_CODE=true       # "why relevant" built from search results; shorter model output
TOOL_TEXT_CHARS=600                # lesson text sent to the model per hit (full text kept for the checks)

# ---------- Answer behaviour ----------
FEATURE_CLARIFYING_QUESTIONS=true
FEATURE_GROUNDING_CHECKS=true      # code checks: cited ID retrieved, quote in text, reasons match data

# ---------- Feedback / admin / UI ----------
FEATURE_FEEDBACK=true
FEEDBACK_STORE=file                # data/feedback.jsonl
FEATURE_UPLOAD_UI=false            # admin upload page
ADMIN_TOKEN=                       # secret; required if FEATURE_UPLOAD_UI=true
UPLOAD_MAX_MB=20
UPLOAD_MAX_ROWS=20000
FEATURE_STREAMING=true
FEATURE_DEBUG_PANEL=false

# ---------- Planned, not built yet (setting them has no effect) ----------
# SEARCH_STORE=pgvector, FEEDBACK_STORE=dynamodb, rerank (Cohere Rerank 3.5), AgentCore guardrails,
# LLM enrichment at ingest (lesson cards), MCP server, search-first fast path.

# ---------- Evidence grader agent (optional) ----------
FEATURE_EVIDENCE_GRADING=false     # grade found lessons before answering; abstain if none fit
GRADER_PROVIDER=                   # default: LLM_PROVIDER
GRADER_MODEL_ID=                   # default: LLM_MODEL_ID; tested: us.amazon.nova-2-lite-v1:0 (good); nova-micro was too lenient
GRADER_MAX_CANDIDATES=8
AGENT_GRADER_URL=                  # set to run the grader as its own service (python -m app.cli serve grader)

# ---------- Storage (local disk, or S3 to share between containers) ----------
STORAGE=local                      # local | s3
# S3_BUCKET=
# S3_PREFIX=lessons
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=                 # only for a local S3 stand-in (moto)
# S3_AWS_PROFILE=                  # local testing only; on AWS the task role is used
INDEX_POLL_SECONDS=30              # how often a container checks for a new index version / new votes

# ---------- Evaluation (optional: your own question set) ----------
# EVAL_QUESTIONS=./my-eval/questions.yaml   # questions with expected lesson IDs, for `python -m app.cli eval`
# EVAL_DATASET=./my-eval/dataset.yaml       # the dataset mapping those questions were written for

# ---------- Wording ----------
# APP_NAME=Talk to Lessons Learned  # name in the UI; overrides app_name in config/assistant.yaml
ASSISTANT_CONFIG=./config/assistant.yaml# app name, prompt wording, example questions, word lists
